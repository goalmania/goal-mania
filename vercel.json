{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "app/api/cron/generate-graphics/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/generate-article",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/generate-article",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/generate-jersey-article",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cart-recovery",
      "schedule": "0 11 * * *"
    }
  ]
}
