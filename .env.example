# Variabili d'ambiente richieste — copiare in .env.local e compilare.
# .env.local NON viene committato.

# Database
MONGODB_URI=

# Cloudinary (usato da scripts/migrate-images.mjs e scripts/upload-player-images.mjs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Token admin per l'endpoint /api/update-product-images (usato da scripts/upload-player-images.mjs)
ADMIN_UPDATE_TOKEN=
